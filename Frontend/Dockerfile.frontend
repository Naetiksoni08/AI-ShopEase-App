# -----------------------------------------------------------------------
# Frontend Dockerfile — Vite/React, multi-stage build
# -----------------------------------------------------------------------
# WHY MULTI-STAGE:
# Stage 1 ("build") needs the full Node toolchain to run `npm run build`,
# which produces static HTML/CSS/JS files in a /dist folder.
# Stage 2 ("serve") only needs Nginx to serve those static files — it does
# NOT need Node, npm, or any of your source code inside it.
#
# Result: final image is tiny (~25MB nginx image + your built files)
# instead of dragging around the entire Node toolchain (~150MB+) into
# production. This is the standard pattern for any static frontend.
# -----------------------------------------------------------------------

# ---------- Stage 1: Build ----------
    FROM node:20-alpine AS build

    WORKDIR /app
    
    # Same caching trick as backend: copy package files first
    COPY package*.json ./
    RUN npm install
    
    # Copy rest of frontend source
    COPY . .
    
    # This is the important part: Vite needs to know your backend API URL
    # AT BUILD TIME (it gets baked into the static JS bundle, since
    # import.meta.env.VITE_API_URL is replaced during build, not at runtime).
    # We pass it in as a build argument so it can change per environment.
    ARG VITE_API_URL
    ENV VITE_API_URL=$VITE_API_URL
    
    RUN npm run build
    # ^ this produces a /app/dist folder with plain HTML/CSS/JS
    
    # ---------- Stage 2: Serve ----------
    FROM nginx:alpine
    
    # Remove default nginx welcome page config
    RUN rm -rf /usr/share/nginx/html/*
    
    # Copy ONLY the built static files from Stage 1 into nginx's serve directory
    COPY --from=build /app/dist /usr/share/nginx/html
    
    # Custom nginx config — needed because React Router uses client-side
    # routing. Without this, refreshing a page like /product/123/show
    # would 404, because nginx would look for a literal file at that path.
    COPY nginx.conf /etc/nginx/conf.d/default.conf
    
    EXPOSE 80
    
    CMD ["nginx", "-g", "daemon off;"]